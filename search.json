---
layout: null
permalink: /search.json
sitemap: false
---
{%- assign items = site.posts | concat: site.pages -%}
{%- assign sep = "" -%}
[
{%- for item in items -%}
  {%- if item.title and item.url != "/search.json" and item.url != "/404.html" -%}
  {%- unless item.path contains "template" -%}
  {{ sep }}{
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "type": {% if item.date %}"post"{% else %}"page"{% endif %},
    "date": {% if item.date %}{{ item.date | date: "%b %-d, %Y" | jsonify }}{% else %}""{% endif %},
    "tags": {{ item.tags | join: ", " | jsonify }},
    "category": {{ item.categories | join: ", " | jsonify }},
    "content": {{ item.content | strip_html | replace: "&nbsp;", " " | normalize_whitespace | truncatewords: 120 | jsonify }}
  }
  {%- assign sep = "," -%}
  {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
]
